<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
      prefHeight="700.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="TestingController"
      stylesheets="@style.css">

   <children>
      <HBox prefHeight="450.0" prefWidth="600.0">
         <children>
            
            <VBox prefWidth="413.0">
               <children>
                  <TabPane fx:id="tabPane" prefHeight="150.0" prefWidth="413.0" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                      
                      <Tab fx:id="setSceneTab" text="Set Scene">
                        <content>
                          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="120.0" prefWidth="389.0">
                            <children>
                            	<Label fx:id="bonePromptLabel" layoutX="10" layoutY="10"
                                     text="Press 'Pick a Bone' to start"
                                     wrapText="true" prefWidth="250.0"
                                     style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                              <Button text="Pick a Bone" onAction="#clickPickBone"
                                      layoutX="10" layoutY="60"/>
                              <Button text="Start Video" onAction="#clickStartVideo"
                                      layoutX="120" layoutY="60"/>
                            </children>
                           </AnchorPane>
                        </content>
                      </Tab>
                      
                      <Tab fx:id="takeSceneTab" text="Snapshot">
                        <content>
                          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="120.0" prefWidth="389.0">
                            <children>
                              <Button text="Save Snapshot" onAction="#clickSnapshot"
                                      layoutX="10" layoutY="10"/>
                              <Button text="Stop Video" onAction="#clickStopVideo"
                                      layoutX="130" layoutY="10"/>
                              <Button text="Check Result" onAction="#clickCheckResult"
                                      layoutX="230" layoutY="10"/>
                              <Label fx:id="feedbackLabel" layoutX="10" layoutY="50"
                                     text="" wrapText="true" prefWidth="370.0"
                                     style="-fx-font-size: 14px;"/>
                            </children>
                          </AnchorPane>
                        </content>
                      </Tab>
                      
                    </tabs>
                  </TabPane>
                  
                  <ImageView fx:id="cameraView" fitHeight="300.0" fitWidth="413.0" preserveRatio="true" />
               </children>
            </VBox>
            

            <TabPane fx:id="resultTabPane" prefHeight="450.0" prefWidth="187.0" tabClosingPolicy="UNAVAILABLE">
			  <tabs>
			    <Tab fx:id="testingTab" text="Testing">
			      <content>
			        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
			          <children>
			            <ScrollPane layoutX="1.0" layoutY="5.0" prefHeight="400.0" prefWidth="180.0">
			              <content>
			                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="400.0" prefWidth="160.0">
			                  <children>
			                    <Label fx:id="resultLabel" layoutX="5.0" layoutY="5.0" 
			                           prefWidth="150.0" wrapText="true" text="" />
			                  </children>
			                </AnchorPane>
			              </content>
			            </ScrollPane>
			          </children>
			        </AnchorPane>
			      </content>
			    </Tab>
			  </tabs>
			</TabPane>
         </children>
      </HBox>

      <ScrollPane fx:id="information" prefHeight="200.0" prefWidth="200.0">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="582.0" />
        </content>
      </ScrollPane>
      <ButtonBar prefHeight="40.0" prefWidth="200.0">
        <buttons>
          <Button fx:id="buttonBack" mnemonicParsing="false" onAction="#clickBack" text="Back to Menu" />
        </buttons>
      </ButtonBar>
   </children>
</VBox>
